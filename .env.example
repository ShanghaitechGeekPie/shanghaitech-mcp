# Public base URL of this deployment (used for CAS service URLs and probe endpoints).
PUBLIC_BASE_URL=https://shanghaitech-mcp.vercel.app

# Interim bearer token for IDE/CLI clients. If unset, /api/mcp is unauthenticated.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Session store (two-level: root ticket + derived platform cookies).
# Upstash Redis REST (Vercel Marketplace "Upstash" injects these). Without them a
# per-process in-memory map is used — fine for local dev, useless across edge
# instances in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# REQUIRED for ids_login: 32 random bytes, base64. Generate: openssl rand -base64 32
MCP_ENC_KEY=

# Campus identity service (Wisedu IDS implementing the Apereo CAS wire protocol).
IDS_BASE_URL=https://ids.shanghaitech.edu.cn

# Public CourseBench API used by the course tools.
COURSEBENCH_BASE_URL=https://coursebench.zambar.dev

# Campus print platform (LAN-only). Same username/password as IDS; token is
# minted during ids_login.
PRINT_BASE_URL=http://10.15.21.225

# WikiTech (Wiki.js). Search/list are public; page content needs an API key
# (Wiki.js admin → API Access, pages:read).
WIKI_BASE_URL=https://wiki.geekpie.club
WIKI_API_TOKEN=
