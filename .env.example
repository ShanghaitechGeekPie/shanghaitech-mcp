# Public base URL of this deployment (used for CAS service URLs and probe endpoints).
PUBLIC_BASE_URL=https://shanghaitech-mcp.vercel.app

# Interim bearer token for IDE/CLI clients. If unset, /api/mcp is unauthenticated.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# REQUIRED for ids_login: 32 random bytes, base64. Generate: openssl rand -base64 32
MCP_ENC_KEY=

# Campus identity service (Wisedu IDS implementing the Apereo CAS wire protocol).
IDS_BASE_URL=https://ids.shanghaitech.edu.cn

# Public CourseBench API used by the course tools.
COURSEBENCH_BASE_URL=https://coursebench.zambar.dev
